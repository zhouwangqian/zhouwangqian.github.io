plot(x, prop,
main = "Proportional data",
xlab = "x",
ylab = "Observed proportion",
ylim = c(0, 1))
abline(model_prop_lm, col = "red", lwd = 2)
# Plot residuals
plot(fitted(model_prop_lm), resid(model_prop_lm),
main = "Residuals: uneven spread",
xlab = "Fitted values",
ylab = "Residuals")
abline(h = 0, col = "red", lwd = 2)
# ============================================================
# Comparing Ordinary Continuous Data and Proportional Data
# 2 x 2 panel version
# ============================================================
set.seed(123)
n <- 300
x <- runif(n, 0, 10)
# 1 ---- Ordinary continuous data ----
y <- 2 + 0.5 * x + rnorm(n, mean = 0, sd = 1)
model_cont <- lm(y ~ x)
# 2 ---- Proportional data ----
p <- plogis(-3 + 0.6 * x)
trials <- 20
successes <- rbinom(n, size = trials, prob = p)
prop <- successes / trials
model_prop_lm <- lm(prop ~ x)
# 3 ---- Plot all four panels together ----
par(mfrow = c(2, 2))
par(mar = c(5, 5, 4, 2))
# Panel 1: ordinary continuous data
plot(x, y,
main = "Ordinary continuous data",
xlab = "x",
ylab = "y")
abline(model_cont, col = "red", lwd = 2)
# Panel 2: residuals for ordinary continuous data
plot(fitted(model_cont), resid(model_cont),
main = "Residuals: constant spread",
xlab = "Fitted values",
ylab = "Residuals")
abline(h = 0, col = "red", lwd = 2)
# Panel 3: proportional data
plot(x, prop,
main = "Proportional data",
xlab = "x",
ylab = "Observed proportion",
ylim = c(0, 1))
abline(model_prop_lm, col = "red", lwd = 2)
# Panel 4: residuals for proportional data
plot(fitted(model_prop_lm), resid(model_prop_lm),
main = "Residuals: uneven spread",
xlab = "Fitted values",
ylab = "Residuals")
abline(h = 0, col = "red", lwd = 2)
par(mfrow = c(2, 2))
# mar = c(bottom, left, top, right)
# oma = outer margin
par(mar = c(3.5, 3.5, 2.5, 1),
oma = c(0, 0, 1, 0),
mgp = c(2, 0.7, 0),
tcl = -0.3)
# Panel 1
plot(x, y,
main = "Ordinary continuous data",
xlab = "x",
ylab = "y")
abline(model_cont, col = "red", lwd = 2)
# Panel 2
plot(fitted(model_cont), resid(model_cont),
main = "Residuals: constant spread",
xlab = "Fitted values",
ylab = "Residuals")
abline(h = 0, col = "red", lwd = 2)
