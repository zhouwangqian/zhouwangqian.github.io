# ============================================================
# 5 ---- Extra plots: why assumptions are violated ----
# ============================================================
par(mfrow = c(1, 2))
par(mar = c(3.2, 3, 2, 0.5),
oma = c(0, 0, 1, 0),
mgp = c(2, 0.7, 0),
tcl = -0.3)
# ------------------------------------------------------------
# Plot 1: Errors are not normally distributed
# because they have "cut tails"
# ------------------------------------------------------------
fitted_prop <- fitted(model_prop_lm)
resid_prop <- resid(model_prop_lm)
plot(fitted_prop, resid_prop,
main = "Residuals have cut tails",
xlab = "Fitted proportion",
ylab = "Residuals",
pch = 16,
col = "blue")
abline(h = 0, col = "red", lwd = 2)
# Add theoretical upper and lower limits for residuals
# Since observed proportions must be between 0 and 1:
# residual = observed - fitted
# minimum residual = 0 - fitted
# maximum residual = 1 - fitted
fitted_sorted <- sort(fitted_prop)
lower_bound <- 0 - fitted_sorted
upper_bound <- 1 - fitted_sorted
lines(fitted_sorted, lower_bound,
col = "darkgreen",
lwd = 2,
lty = 2)
lines(fitted_sorted, upper_bound,
col = "darkgreen",
lwd = 2,
lty = 2)
legend("topright",
legend = c("Residuals", "Possible residual limits"),
col = c("blue", "darkgreen"),
pch = c(16, NA),
lty = c(NA, 2),
lwd = c(NA, 2),
bty = "n")
# ------------------------------------------------------------
# Plot 2: Variance is not constant
# It follows a reversed-U shape
# ------------------------------------------------------------
variance <- p * (1 - p) / trials
p_sorted <- sort(p)
variance_sorted <- p_sorted * (1 - p_sorted) / trials
plot(p, variance,
main = "Variance is not constant",
xlab = "True proportion (p)",
ylab = "Variance",
pch = 16,
col = "blue")
lines(p_sorted, variance_sorted,
col = "red",
lwd = 2)
abline(v = 0.5,
col = "darkgreen",
lty = 2,
lwd = 2)
legend("top",
legend = c("Variance", "Maximum at p = 0.5"),
col = c("red", "darkgreen"),
lty = c(1, 2),
lwd = 2,
bty = "n")
# ============================================================
# Extra plots: cut bell curve + reversed-U variance
# ============================================================
par(mfrow = c(1, 2))
par(mar = c(3.2, 3, 2, 0.5),
oma = c(0, 0, 1, 0),
mgp = c(2, 0.7, 0),
tcl = -0.3)
# ------------------------------------------------------------
# Left panel: residual distribution / cut bell curve
# ------------------------------------------------------------
resid_cont <- resid(model_cont)
resid_prop <- resid(model_prop_lm)
# Density curves
dens_cont <- density(resid_cont)
dens_prop <- density(resid_prop)
# Plot ordinary continuous residuals first
plot(dens_cont,
main = "Normal-like vs. cut residuals",
xlab = "Residuals",
ylab = "Density",
lwd = 2,
col = "black",
xlim = range(c(dens_cont$x, dens_prop$x)),
ylim = range(c(dens_cont$y, dens_prop$y)))
# Add proportional-data residuals
lines(dens_prop,
col = "blue",
lwd = 2)
# Add a vertical line at 0
abline(v = 0,
col = "red",
lty = 2,
lwd = 2)
legend("topright",
legend = c("Ordinary continuous data", "Proportional data"),
col = c("black", "blue"),
lwd = 2,
bty = "n")
# ------------------------------------------------------------
# Right panel: variance is not constant
# reversed-U shape
# ------------------------------------------------------------
variance <- p * (1 - p) / trials
p_sorted <- sort(p)
variance_sorted <- p_sorted * (1 - p_sorted) / trials
plot(p, variance,
main = "Variance is not constant",
xlab = "True proportion (p)",
ylab = "Variance",
pch = 16,
col = "blue")
lines(p_sorted, variance_sorted,
col = "red",
lwd = 2)
abline(v = 0.5,
col = "darkgreen",
lty = 2,
lwd = 2)
legend("top",
legend = c("Reversed-U variance", "Maximum at p = 0.5"),
col = c("red", "darkgreen"),
lty = c(1, 2),
lwd = 2,
bty = "n")
grid()
